# Reown AppKit (WalletConnect) project id, from https://dashboard.reown.com
#
# Optional. Without it the WalletConnect modal cannot open and the app falls
# back to injected wallets such as MetaMask, which is enough to use every
# screen. Set it to support mobile and hardware wallets.
#
# Public by design: it is shipped to the browser and only scopes relay traffic.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Contract addresses are NOT set here. They are committed, generated from
# packages/contracts/deployments/sepolia.json into
# packages/web/lib/contracts/addresses.ts by the deploy script.
