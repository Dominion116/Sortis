# Reown AppKit (WalletConnect) project id, from https://dashboard.reown.com
#
# Optional. Without it the WalletConnect modal cannot open and the app falls
# back to injected wallets such as MetaMask, which is enough to use every
# screen. Set it to support mobile and hardware wallets.
#
# Public by design: it is shipped to the browser and only scopes relay traffic.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Contract addresses are NOT set here. They are committed, generated from
# packages/contracts/deployments/sepolia.json into
# packages/web/lib/contracts/addresses.ts by the deploy script.
# Optional comma-separated hostnames/IPs allowed to load Next.js dev assets.
# Local IPv4 addresses are detected automatically.
# SORTIS_DEV_ORIGINS=my-laptop.local,192.168.1.20

# Vercel Cron keeper. Keep these server-only values out of NEXT_PUBLIC_*.
CRON_SECRET=
SORTIS_KEEPER_PRIVATE_KEY=
# Used by the keeper and by the same-origin /api/rpc proxy. The browser SDK
# does not call this URL directly: some wallets intercept public RPC hosts.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# This is not a secret, but it is used to access the Zama FHEVM API. You can get your own key at https://fhevm.zama.ai.
ZAMA_FHEVM_API_KEY=

# Postgres for the indexer and the per-round prize history. OPTIONAL.
#
# Without it the app still works: rounds advance, /verify/[roundId] falls back to
# a bounded getLogs scan, and the past-rounds card on /app/prizes hides itself.
# With it, round history is complete since deployment and a user can check
# whether a specific past round was won.
#
# Server-only. Never prefix this with NEXT_PUBLIC_. Any serverless Postgres with
# an HTTP-capable connection string works; Neon is what this was built against.
DATABASE_URL=

# The daily Vercel cron in vercel.json is a backstop, not the real schedule. The
# demo pool has 300-second rounds and a round needs several sequential keeper
# invocations to settle, so point an external scheduler (cron-job.org, Upstash
# QStash, or Vercel Pro cron) at both routes every minute, with the header:
#   Authorization: Bearer $CRON_SECRET
#   GET /api/cron/keeper
#   GET /api/cron/indexer
