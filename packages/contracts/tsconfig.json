{
  "compilerOptions": {
    "target": "ES2022",
    // node16 resolution emits CommonJS here (no "type": "module" in package.json),
    // which is what Hardhat and ts-node expect, without the deprecated node10 mode.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "./hardhat.config.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
    "./tasks/**/*.ts",
    "./typechain-types/**/*.ts"
  ],
  "exclude": ["node_modules", "artifacts", "cache", "dist"]
}
