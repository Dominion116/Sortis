# Sortis contracts — environment template.
# Copy to `.env` (which is gitignored) and fill in. Never commit real values.

# JSON-RPC endpoint for Ethereum Sepolia (Alchemy, Infura, or your own node).
# A public endpoint is fine for the initial bring-up; a dedicated key is
# better once the keeper is firing every five minutes.
SEPOLIA_RPC_URL=

# Private key of the deployer account. The 0x-prefixed form is preferred.
# Use a throwaway testnet key only. Never commit the filled `.env`.
DEPLOYER_PRIVATE_KEY=

# Optional. Defaults to the deployer. In production this is the Vercel Cron
# hot key that closes rounds and steps the sweep.
KEEPER_ADDRESS=

# Etherscan v2 API key, used by `hardhat verify`. Sourcify verification still
# runs if this is left empty.
ETHERSCAN_API_KEY=

# Set to "true" to switch the gas reporter on for a run. Off by default because
# full gas accounting is Phase 6 work and it slows the suite down.
REPORT_GAS=false
