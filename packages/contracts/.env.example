# Sortis contracts — environment template.
# Copy to `.env` (which is gitignored) and fill in. Never commit real values.

# JSON-RPC endpoint for Ethereum Sepolia (Alchemy, Infura, or your own node).
SEPOLIA_RPC_URL=

# Private key of the deployer account, without the 0x prefix is also accepted by
# most tooling but the 0x form is preferred. Use a throwaway testnet key only.
DEPLOYER_PRIVATE_KEY=

# Etherscan v2 API key, used by `hardhat verify` / `etherscan-verify`.
ETHERSCAN_API_KEY=

# Set to "true" to switch the gas reporter on for a run. Off by default because
# full gas accounting is Phase 6 work and it slows the suite down.
REPORT_GAS=false
