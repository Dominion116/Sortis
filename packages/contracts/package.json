{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Sortis confidential prize savings protocol — Hardhat workspace",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "abis": "ts-node --project tsconfig.json scripts/generate-abis.ts",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "coverage": "hardhat coverage",
    "lint": "solhint \"contracts/**/*.sol\"",
    "typecheck": "tsc --noEmit",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "smoke:sepolia": "hardhat run scripts/sepolia-smoke.ts --network sepolia"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "0.11.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.9",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "encrypted-types": "^0.0.4",
    "ethers": "^6.16.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "mocha": "^11.0.1",
    "solhint": "^5.0.5",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.2"
  }
}
